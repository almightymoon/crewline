// Crewline Prisma schema — ported from backend/app/models.py

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  role            String // client | freelancer | admin
  color           String    @default("#0071e3")
  avatar          String    @default("")
  balance         Decimal   @default(0)
  isActive        Boolean   @default(true) @map("is_active")
  suspendedReason String    @default("") @map("suspended_reason")
  notifyPrefs     Json      @map("notify_prefs")
  createdAt       DateTime  @default(now()) @map("created_at")
  lastLoginAt     DateTime? @map("last_login_at")

  freelancer FreelancerProfile?
  client     ClientProfile?

  gigs                      Gig[]          @relation("GigFreelancer")
  jobs                      Job[]          @relation("JobClient")
  proposals                 Proposal[]     @relation("ProposalFreelancer")
  clientOrders              Order[]        @relation("OrderClient")
  freelancerOrders          Order[]        @relation("OrderFreelancer")
  disputeOrders             Order[]        @relation("OrderDisputeBy")
  reviewsGiven              Review[]       @relation("ReviewClient")
  reviewsReceived           Review[]       @relation("ReviewFreelancer")
  clientReviewsAsClient     ClientReview[] @relation("ClientReviewClient")
  clientReviewsAsFreelancer ClientReview[] @relation("ClientReviewFreelancer")
  transactions              Transaction[]
  conversationsAsClient     Conversation[] @relation("ConvClient")
  conversationsAsFreelancer Conversation[] @relation("ConvFreelancer")
  messages                  Message[]
  notifications             Notification[]
  adminLogs                 AdminLog[]

  @@map("users")
}

model FreelancerProfile {
  userId        Int     @id @map("user_id")
  headline      String  @default("")
  bio           String  @default("")
  location      String  @default("")
  category      String  @default("dev")
  skills        Json
  hourlyRate    Decimal @default(0) @map("hourly_rate")
  available     Boolean @default(true)
  rating        Float   @default(0)
  reviewsCount  Int     @default(0) @map("reviews_count")
  jobsCompleted Int     @default(0) @map("jobs_completed")
  languages     Json
  experience    Json
  portfolio     Json
  visible       Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("freelancer_profiles")
}

model ClientProfile {
  userId     Int     @id @map("user_id")
  company    String  @default("")
  bio        String  @default("")
  location   String  @default("")
  verified   Boolean @default(false)
  totalSpent Decimal @default(0) @map("total_spent")
  website    String  @default("")
  industry   String  @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Gig {
  id           Int      @id @default(autoincrement())
  freelancerId Int      @map("freelancer_id")
  title        String
  category     String
  description  String
  tags         Json
  image        String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  freelancer User         @relation("GigFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  packages   GigPackage[]
  orders     Order[]

  @@index([freelancerId])
  @@index([category])
  @@map("gigs")
}

model GigPackage {
  id           Int     @id @default(autoincrement())
  gigId        Int     @map("gig_id")
  tier         String // basic | standard | premium
  price        Decimal
  deliveryDays Int     @map("delivery_days")
  revisions    Int     @default(1) // -1 = unlimited
  features     Json

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([gigId, tier])
  @@index([gigId])
  @@map("gig_packages")
}

model Job {
  id              Int      @id @default(autoincrement())
  clientId        Int      @map("client_id")
  title           String
  category        String
  description     String
  skills          Json
  budget          Decimal
  status          String   @default("open") // open | in_progress | closed
  experienceLevel String   @default("intermediate") @map("experience_level")
  duration        String   @default("month")
  createdAt       DateTime @default(now()) @map("created_at")

  client    User       @relation("JobClient", fields: [clientId], references: [id], onDelete: Cascade)
  proposals Proposal[]
  orders    Order[]

  @@index([clientId])
  @@index([category])
  @@index([status])
  @@map("jobs")
}

model Proposal {
  id           Int      @id @default(autoincrement())
  jobId        Int      @map("job_id")
  freelancerId Int      @map("freelancer_id")
  bid          Decimal
  deliveryDays Int      @map("delivery_days")
  coverLetter  String   @map("cover_letter")
  status       String   @default("pending") // pending | accepted | rejected | withdrawn
  createdAt    DateTime @default(now()) @map("created_at")

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer User @relation("ProposalFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
  @@map("proposals")
}

model Order {
  id              Int       @id @default(autoincrement())
  clientId        Int       @map("client_id")
  freelancerId    Int       @map("freelancer_id")
  title           String
  amount          Decimal
  buyerFee        Decimal   @default(0) @map("buyer_fee")
  status          String    @default("funded") // funded | in_progress | delivered | revision | released | cancelled
  gigId           Int?      @map("gig_id")
  jobId           Int?      @map("job_id")
  package         String?
  sellerFeePct    Decimal   @default(0.10) @map("seller_fee_pct")
  disputed        Boolean   @default(false)
  disputeReason   String    @default("") @map("dispute_reason")
  disputeBy       Int?      @map("dispute_by")
  disputeOpenedAt DateTime? @map("dispute_opened_at")
  resolutionNote  String    @default("") @map("resolution_note")
  deliveryDays    Int       @default(7) @map("delivery_days")
  createdAt       DateTime  @default(now()) @map("created_at")
  deliveredAt     DateTime? @map("delivered_at")
  releasedAt      DateTime? @map("released_at")

  client      User          @relation("OrderClient", fields: [clientId], references: [id])
  freelancer  User          @relation("OrderFreelancer", fields: [freelancerId], references: [id])
  disputeUser User?         @relation("OrderDisputeBy", fields: [disputeBy], references: [id], onDelete: SetNull)
  gig         Gig?          @relation(fields: [gigId], references: [id], onDelete: SetNull)
  job         Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  review      Review?
  clientReview ClientReview?
  transactions Transaction[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@index([disputed])
  @@map("orders")
}

model Review {
  id           Int      @id @default(autoincrement())
  orderId      Int      @unique @map("order_id")
  clientId     Int      @map("client_id")
  freelancerId Int      @map("freelancer_id")
  rating       Int
  comment      String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  client     User  @relation("ReviewClient", fields: [clientId], references: [id])
  freelancer User  @relation("ReviewFreelancer", fields: [freelancerId], references: [id])

  @@index([freelancerId])
  @@map("reviews")
}

model ClientReview {
  id           Int      @id @default(autoincrement())
  orderId      Int?     @unique @map("order_id")
  clientId     Int      @map("client_id")
  freelancerId Int      @map("freelancer_id")
  rating       Int
  comment      String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")

  order      Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  client     User   @relation("ClientReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer User   @relation("ClientReviewFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_reviews")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  kind        String // deposit | escrow_hold | refund | earning | withdrawal
  amount      Decimal
  description String   @default("")
  orderId     Int?     @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("transactions")
}

model Conversation {
  id           Int      @id @default(autoincrement())
  clientId     Int      @map("client_id")
  freelancerId Int      @map("freelancer_id")
  createdAt    DateTime @default(now()) @map("created_at")

  client     User      @relation("ConvClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer User      @relation("ConvFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([clientId, freelancerId])
  @@index([clientId])
  @@index([freelancerId])
  @@map("conversations")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  body           String
  read           Boolean   @default(false)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, id], map: "ix_messages_conv_id")
  @@map("messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  kind      String
  title     String
  body      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, id], map: "ix_notifications_user")
  @@map("notifications")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?     @map("admin_id")
  action    String
  target    String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("admin_logs")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}
